APP_ENV=development
# Relative SQLite paths resolve from backend/. Omit for backend/data/politiads.db.
DATABASE_URL=sqlite:///./data/politiads.db
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Generate independent secrets before production; defaults are development-only.
APP_SECRET_KEY=dev_secret_key_change_in_production_32chars
ENCRYPTION_KEY=k9X2bY1p9R_vQ0wU7oZ_mN5eT3sA1dF4hJ6kL8zC2vM=
META_MOCK_MODE=true
# Live Meta publication is deliberately unavailable, even with credentials.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_KILL_SWITCH=false
RAZORPAY_MOCK_MODE=true
RAZORPAY_KEY_ID=rzp_test_politiads_demo
RAZORPAY_KEY_SECRET=test_secret_key_razorpay_9988
RAZORPAY_WEBHOOK_SECRET=whsec_politiads_webhook_test_2026

# Real Facebook Login / Facebook Page + Instagram connections (separate from publishing).
META_OAUTH_ENABLED=false
META_OAUTH_GRAPH_VERSION=v24.0
META_OAUTH_REDIRECT_URI=http://localhost:5173/api/meta/oauth/callback
# Optional Facebook Login for Business configuration ID from your Meta app.
META_BUSINESS_CONFIG_ID=
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,ads_management,ads_read
# META_APP_ID/META_APP_SECRET above must be your own app credentials.
# Register exactly the callback URI above in the app's Valid OAuth Redirect URIs.
# Production requires an HTTPS domain and secure cookies. Real account authorization is still required.
