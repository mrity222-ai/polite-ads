                      >
                        <RefreshCw className={`w-3.5 h-3.5 ${apiHealthState.isTesting ? 'animate-spin' : ''}`} />
                        {apiHealthState.isTesting ? 'Testing Handshake...' : '⚡ Test Meta Connection'}
                      </button>
                    </div>

                    {/* WhatsApp Cloud API */}
                    <div className="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                      <div className="flex justify-between items-center">
                        <span className="text-xs font-bold text-emerald-400 flex items-center gap-1.5">
                          <span className="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                          WhatsApp Cloud API
                        </span>
                        <span className="text-[10px] text-gray-400 font-mono">WABA: 2091481</span>
                      </div>

                      <div>
                        <h4 className="text-base font-bold text-white">Voter Lead Delivery</h4>
                        <p className="text-xs text-gray-400 mt-1">Routes ad clicks directly into candidate's phone inbox.</p>
                      </div>

                      <div className="space-y-1.5 text-xs text-gray-300 bg-slate-950 p-3 rounded-xl border border-slate-800 font-mono">
                        <div>Business Phone ID: 1084201948</div>
                        <div>Template Messages: Approved (ECI)</div>
                        <div className="text-emerald-400 font-bold">Status: Online & Ready 🟢</div>
                      </div>

                      <button
                        onClick={() => alert('WhatsApp Webhook ping successful! All message queues are healthy.')}
                        className="w-full py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-gray-200 transition"
                      >
                        Ping WhatsApp Webhook
                      </button>
                    </div>

                    {/* AI Copywriting Engine */}
                    <div className="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                      <div className="flex justify-between items-center">
                        <span className="text-xs font-bold text-amber-400 flex items-center gap-1.5">
                          <Sparkles className="w-3.5 h-3.5 text-amber-400" />
                          AI Copywriting Engine
                        </span>
                        <span className="text-[10px] text-gray-400 font-mono">Latency: 0.8s</span>
                      </div>

                      <div>
                        <h4 className="text-base font-bold text-white">Election Slogan Polisher</h4>
                        <p className="text-xs text-gray-400 mt-1">Fine-tuned model for Hindi/Hinglish political appeals.</p>
                      </div>

                      <div className="space-y-1.5 text-xs text-gray-300 bg-slate-950 p-3 rounded-xl border border-slate-800 font-mono">
                        <div>Model: Gemini 2.5 / GPT-4o Political</div>
                        <div>Avg Enhancement: 0.8s</div>
                        <div className="text-emerald-400 font-bold">Status: Operational 🟢</div>
                      </div>

                      <button
                        onClick={() => alert('AI Model connection tested. Ready for political ad copywriting enhancements.')}
