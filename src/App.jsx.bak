                              <td className="py-3 px-4 text-gray-400">{t.date}</td>
                              <td className="py-3 px-4 text-gray-300 font-medium">{t.mode}</td>
                              <td className="py-3 px-4 font-bold text-white">₹{t.amount}</td>
                              <td className="py-3 px-4 font-bold text-amber-400">+ ₹{t.companyCut}</td>
                              <td className="py-3 px-4 font-bold text-emerald-400">₹{t.metaPayout}</td>
                              <td className="py-3 px-4">
                                <span className="bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full text-[10px] font-bold">
                                  {t.status}
                                </span>
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              )}

            </main>
          </div>
        </div>
      )}

      {/* ========================================================
          BOSS SUITE MODAL 1: CANDIDATE FULL DOSSIER
      ======================================================== */}
      {selectedCandidateDossier && (
        <div className="fixed inset-0 z-50 bg-gray-950/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl p-6 sm:p-8 text-white shadow-2xl relative my-8">
            <button
              onClick={() => setSelectedCandidateDossier(null)}
              className="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800 text-gray-400 hover:text-white flex items-center justify-center transition"
            >
              <X className="w-4 h-4" />
            </button>

            <div className="flex items-center gap-4 border-b border-slate-800 pb-5">
              <div className="w-14 h-14 rounded-2xl bg-amber-400 text-slate-950 font-black text-xl flex items-center justify-center">
                {selectedCandidateDossier.name.charAt(0)}
              </div>
              <div>
                <span className="text-[10px] font-mono font-bold bg-amber-400 text-slate-950 px-2 py-0.5 rounded-full">
                  {selectedCandidateDossier.id}
                </span>
                <h3 className="text-lg font-bold text-white mt-1">{selectedCandidateDossier.name}</h3>
                <p className="text-xs text-gray-400">{selectedCandidateDossier.post}</p>
              </div>
            </div>

            <div className="py-5 space-y-3.5 text-xs text-gray-300">
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">Ward & Pincode:</span>
                <span className="font-semibold text-white">{selectedCandidateDossier.ward} ({selectedCandidateDossier.pincode})</span>
              </div>
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">Election Symbol:</span>
                <span className="font-semibold text-amber-400">{selectedCandidateDossier.symbol}</span>
              </div>
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">GPS Coordinates:</span>
                <span className="font-mono text-gray-300">{selectedCandidateDossier.lat}, {selectedCandidateDossier.lng}</span>
              </div>
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">Current Plan:</span>
                <span className="font-semibold text-emerald-400">{selectedCandidateDossier.plan}</span>
              </div>
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">Total Ads Launched:</span>
                <span className="font-bold text-white">{selectedCandidateDossier.totalAds} Campaigns</span>
              </div>
              <div className="flex justify-between border-b border-slate-800/80 pb-2">
                <span className="text-gray-400">Total Money Deposited:</span>
                <span className="font-black text-emerald-400 text-sm">₹{selectedCandidateDossier.totalSpend}</span>
              </div>
            </div>

            <div className="pt-2 flex gap-3">
              <button
                onClick={() => {
                  const cand = selectedCandidateDossier;
                  setSelectedCandidateDossier(null);
                  handleImpersonateCandidate(cand);
                }}
                className="flex-1 py-3 rounded-xl font-bold text-xs bg-[#bbf7d0] hover:bg-[#86efac] text-slate-950 transition flex items-center justify-center gap-2 shadow-md"
              >
                <UserCheck className="w-4 h-4" />
                Login as this Candidate
              </button>
              <a
                href={`https://wa.me/91${selectedCandidateDossier.phone}`}
                target="_blank"
                rel="noreferrer"
                className="px-4 py-3 rounded-xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-gray-200 transition flex items-center justify-center"
              >
                WhatsApp
              </a>
            </div>
          </div>
        </div>
      )}

      {/* ========================================================
          BOSS SUITE MODAL 2: CREATE SUBSCRIPTION PLAN
      ======================================================== */}
      {isCreatePlanModalOpen && (
        <div className="fixed inset-0 z-50 bg-gray-950/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-slate-900 border border-slate-800 w-full max-w-md rounded-3xl p-6 sm:p-8 text-white shadow-2xl relative my-8">
            <button
              onClick={() => setIsCreatePlanModalOpen(false)}
              className="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800 text-gray-400 hover:text-white flex items-center justify-center transition"
            >
              <X className="w-4 h-4" />
            </button>

            <h3 className="text-lg font-bold text-white mb-1">Create Subscription Packet</h3>
            <p className="text-xs text-gray-400 mb-5">Define new political tier pricing and ad limits.</p>

            <div className="space-y-4 text-xs">
              <div>
                <label className="block text-gray-300 font-semibold mb-1">Plan Name*</label>
                <input 
                  type="text" 
                  placeholder="e.g. Nagar Palika Mega War-Room"
                  value={newPlanName}
                  onChange={(e) => setNewPlanName(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white text-xs"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-gray-300 font-semibold mb-1">Price (₹ / cycle)*</label>
                  <input 
                    type="number" 
                    value={newPlanPrice}
                    onChange={(e) => setNewPlanPrice(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white text-xs"
                  />
                </div>
                <div>
                  <label className="block text-gray-300 font-semibold mb-1">Daily Ad Cap (₹)*</label>
                  <input 
                    type="number" 
                    value={newPlanDailyLimit}
                    onChange={(e) => setNewPlanDailyLimit(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white text-xs"
                  />
                </div>
              </div>

              <div>
                <label className="block text-gray-300 font-semibold mb-1">Features (comma separated)*</label>
                <textarea 
                  rows={3}
                  value={newPlanFeatures}
                  onChange={(e) => setNewPlanFeatures(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-white text-xs"
                />
              </div>

              <button
                onClick={handleCreateNewPlan}
                className="w-full py-3 rounded-xl font-bold text-xs bg-amber-400 hover:bg-amber-300 text-slate-950 transition shadow-md mt-2"
              >
                Create Plan & Deploy to Platform
              </button>
            </div>
          </div>
        </div>
      )}


      {/* ========================================================
          6. "+ CREATE NEW AD" MODAL
      ======================================================== */}
      {isCreateAdModalOpen && (
        <div className="fixed inset-0 z-50 bg-gray-950/60 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 overflow-y-auto">
          <div className="bg-white w-full max-w-5xl rounded-[32px] border border-gray-200 shadow-2xl overflow-hidden my-6 relative flex flex-col max-h-[92vh]">
            
            <div className="p-5 sm:px-8 border-b border-gray-100 flex items-center justify-between bg-white shrink-0">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center">
                  <Megaphone className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gray-950">Create & Submit Political Ad</h3>
                  <p className="text-xs text-gray-500">
                    आप एड सबमिट करें — हमारी एक्सपर्ट कंपनी टीम इसे चेक व बेहतर बनाकर Meta पर लाइव करेगी।
                  </p>
                </div>
              </div>

              <button 
                onClick={() => setIsCreateAdModalOpen(false)}
                className="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-600 flex items-center justify-center transition"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto p-5 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
              <div className="lg:col-span-7 space-y-5">
                {modalError && (
                  <div className="p-3.5 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold flex items-center gap-2">
                    <AlertCircle className="w-4 h-4 shrink-0 text-red-600" />
                    <span>{modalError}</span>
                  </div>
                )}
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-bold text-gray-800 mb-1">Campaign Title*</label>
                    <input 
                      type="text" 
                      value={modalTitle}
                      onChange={(e) => setModalTitle(e.target.value)}
                      className="w-full bg-[#fafafa] border border-gray-300 rounded-xl px-3.5 py-2.5 text-xs text-gray-900 font-medium"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-bold text-gray-800 mb-1">WhatsApp Phone*</label>
                    <input 
                      type="tel"
                      value={modalPhone}
                      onChange={(e) => setModalPhone(e.target.value)}
                      className="w-full bg-[#fafafa] border border-gray-300 rounded-xl px-3 py-2.5 text-xs text-gray-900"
                    />
                  </div>
                </div>

                <div>
                  <label className="block text-xs font-bold text-gray-800 mb-1">Political Slogan (चुनावी नारा)*</label>
                  <input type="text" value={modalSlogan} onChange={(e) => setModalSlogan(e.target.value)} className="w-full bg-[#fafafa] border border-gray-300 rounded-xl px-3.5 py-2.5 text-xs text-gray-900" />
                  <p className="text-[10px] text-emerald-700 mt-1">✨ हमारी कंपनी की कॉपीराइटिंग टीम इस नारे को और अधिक प्रभावशाली बना देगी।</p>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label className="block text-xs font-bold text-gray-800 mb-1">Area / Ward</label>
                    <input type="text" value={modalArea} onChange={(e) => setModalArea(e.target.value)} className="w-full bg-[#fafafa] border border-gray-300 rounded-xl px-3 py-2 text-xs" />
                  </div>
                  <div>
                    <label className="block text-xs font-bold text-gray-800 mb-1">Pincode</label>
                    <input type="text" maxLength={6} value={modalPincode} onChange={(e) => setModalPincode(e.target.value)} className="w-full bg-[#fafafa] border border-gray-300 rounded-xl px-3 py-2 text-xs font-mono" />
                  </div>
                  <div>
                    <label className="block text-xs font-bold text-gray-800 mb-1">Radius</label>
                    <span className="text-xs font-bold text-emerald-700 block mt-2">{modalRadius} km</span>
                  </div>
                </div>

                <div className="p-4 rounded-2xl bg-[#fafafa] border border-gray-200">
                  <div className="flex justify-between items-center mb-1.5">
                    <label className="text-xs font-bold text-gray-800">Daily Ad Budget (दैनिक बजट):</label>
                    <span className="text-sm font-black text-emerald-700">₹{modalDailyBudget} / day</span>
                  </div>
                  <input type="range" min="200" max="5000" step="100" value={modalDailyBudget} onChange={(e) => setModalDailyBudget(Number(e.target.value))} className="w-full accent-emerald-600" />
                </div>
              </div>

              {/* RIGHT PREVIEW */}
              <div className="lg:col-span-5 flex flex-col items-center justify-center">
                <div className="w-full max-w-[280px] rounded-[36px] bg-white p-3 border-4 border-gray-900 shadow-xl">
                  <div className="w-20 h-3 bg-gray-900 rounded-b-lg mx-auto mb-2"></div>
                  <div className="h-44 p-3 text-white flex flex-col justify-between bg-gradient-to-br from-emerald-800 to-slate-950 rounded-xl">
                    <span className="text-[9px] font-bold text-yellow-300">{obPost}</span>
                    <div className="text-center">
                      <p className="font-bold text-sm">{obCandidateName}</p>
                      <p className="text-[10px] text-yellow-300">"{modalSlogan}"</p>
                    </div>
                    <span className="text-[8px] text-gray-300">चिन्ह: {modalSymbol} · {modalArea}</span>
                  </div>
                </div>
                <div className="mt-4 p-3 rounded-xl bg-amber-50 border border-amber-200 text-[11px] text-amber-900 text-center">
                  🛡️ <strong>कंपनी गारंटी:</strong> सबमिट करने के बाद हमारी टीम आपके पोस्टर व टेक्स्ट को चेक व सुंदर बनाकर Meta पर अप्रूव करेगी।
                </div>
              </div>
            </div>

            <div className="p-4 sm:px-8 border-t border-gray-100 bg-gray-50 flex items-center justify-between shrink-0">
              <span className="text-xs text-gray-500">Managed Approval Workflow Enabled</span>
              <div className="flex items-center gap-3">
                <button type="button" onClick={() => setIsCreateAdModalOpen(false)} className="px-5 py-2.5 rounded-full text-xs font-semibold text-gray-600">Cancel</button>
                <button type="button" onClick={handlePublishAdFromModal} className="px-8 py-3 rounded-full font-bold text-xs text-gray-950 bg-[#bbf7d0] hover:bg-[#86efac] shadow-md">
                  Submit Ad for Company Enhancement & Launch →
                </button>
              </div>
            </div>

          </div>
        </div>
      )}

    </div>
  );
}
