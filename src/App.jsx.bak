      name: newPlanName,
      price: Number(newPlanPrice),
      dailyAdLimit: Number(newPlanDailyLimit),
      usersCount: 0,
      badge: 'Custom',
      features: newPlanFeatures.split(',').map(f => f.trim()).filter(Boolean)
