  const handleToggleCandidateStatus = (candidateId) => {
    setCandidatesDirectory(candidatesDirectory.map(cand => {
      if (cand.id === candidateId) {
        const nextStatus = cand.status === 'Active' ? 'Suspended' : 'Active';
        setToastMessage(`Candidate ${cand.name} status updated to ${nextStatus}!`);
        setShowSuccessToast(true);
        setTimeout(() => setShowSuccessToast(false), 3500);
        return { ...cand, status: nextStatus };
      }
      return cand;
    }));
  };

