    setIsCreatePlanModalOpen(false);
    setNewPlanName('');
    setToastMessage(`New Plan "${newPlan.name}" Created Successfully!`);
    setShowSuccessToast(true);
    setTimeout(() => setShowSuccessToast(false), 3500);
