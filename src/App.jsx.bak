                            <th className="py-3 px-4">Gross Paid</th>
                            <th className="py-3 px-4">Company Cut ({companyMarginPct}%)</th>
                            <th className="py-3 px-4">Meta Payout</th>
                            <th className="py-3 px-4">Status</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-800/80 text-gray-200">
                          {transactionsList.map((t) => (
                            <tr key={t.txnId} className="hover:bg-slate-800/40 transition">
